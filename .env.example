# Plantilla de variables de entorno. La app usa Vite, que carga un archivo por modo:
#
#   .env.development  → se carga con `npm run dev`      (proyecto Supabase de desarrollo)
#   .env.production   → se carga con `npm run build`    (proyecto Supabase de producción)
#
# Copia este archivo a cada uno y rellena los valores:
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# Son las mismas credenciales que la app móvil (../cotrol-gastos/.env), solo cambia el prefijo:
#   EXPO_PUBLIC_SUPABASE_URL → VITE_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_KEY → VITE_SUPABASE_ANON_KEY
#
# En despliegue (Cloudflare Pages) no se usan estos archivos: define VITE_SUPABASE_URL y
# VITE_SUPABASE_ANON_KEY en el panel del host para los entornos Production y Preview.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
